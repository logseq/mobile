# The attachment chip can be removed before it is sent.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
wait prop:accessibility-identifier=button.composer.expand
press prop:accessibility-identifier=button.composer.expand
wait prop:accessibility-identifier=button.attachment
press prop:accessibility-identifier=button.attachment
press prop:accessibility-identifier=button.attachment.camera
wait prop:accessibility-identifier=composer.asset.asset-1
press prop:accessibility-identifier=composer.asset.remove
expect-absent prop:accessibility-identifier=composer.asset.asset-1
expect-absent text:"Photo.jpg"
