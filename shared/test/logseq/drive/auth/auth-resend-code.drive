# Resend keeps the confirmation step and shows a new-code notice.
expect prop:accessibility-identifier=screen.authentication
press prop:accessibility-identifier=button.sign-in
expect prop:accessibility-identifier=sheet.authentication
press prop:accessibility-identifier=button.auth.create-account
wait prop:accessibility-identifier=field.auth.username
type prop:accessibility-identifier=field.auth.email "new@example.com"
type prop:accessibility-identifier=field.auth.username "newuser"
type prop:accessibility-identifier=field.auth.password "fixture-password"
type prop:accessibility-identifier=field.auth.password-confirmation "fixture-password"
press prop:accessibility-identifier=button.auth.submit
wait prop:accessibility-identifier=field.auth.code
press prop:accessibility-identifier=button.auth.resend-code
wait text:"A new verification code has been sent."
expect prop:accessibility-identifier=field.auth.code
expect prop:accessibility-identifier=sheet.authentication
