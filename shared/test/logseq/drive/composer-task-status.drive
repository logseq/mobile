# The composer system menu retains its seeded actions; picking a status
# checks it for the next capture, and clearing it removes the selection.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
wait prop:accessibility-identifier=surface.composer.root
wait prop:accessibility-identifier=button.composer.expand
press prop:accessibility-identifier=button.composer.expand
wait prop:accessibility-identifier=field.composer
wait prop:accessibility-identifier=button.task-status
press prop:accessibility-identifier=button.task-status
wait prop:accessibility-identifier=button.task-status.option.ts-1
expect prop:accessibility-identifier=button.task-status.option.ts-1
press prop:accessibility-identifier=button.task-status.option.ts-1
expect-prop prop:accessibility-identifier=button.task-status.option.ts-1 selected true
press prop:accessibility-identifier=button.task-status.clear
expect-prop prop:accessibility-identifier=button.task-status.option.ts-1 selected false
expect-absent prop:accessibility-identifier=button.task-status.clear
