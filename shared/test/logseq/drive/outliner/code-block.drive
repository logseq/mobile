# A code block can switch language and start another block.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
wait prop:accessibility-identifier=outliner.block.code-1
press prop:accessibility-identifier=button.outliner.code-language.option.ocaml
expect text:"ocaml"
ext ext:outliner-block-row outliner-block-row edit '{"uuid":"code-1"}'
wait prop:accessibility-identifier=button.outliner.editor.newBlock
press prop:accessibility-identifier=button.outliner.editor.newBlock
expect-prop ext:outliner-editor block-id "new-block"
expect-prop ext:outliner-editor title "New block"
expect-absent prop:accessibility-identifier=button.outliner.editor.newBlock
expect prop:accessibility-identifier=button.outliner.editor.lineBreak
expect text:'"uuid":"new-block"'&text:'"editing":true'
expect text:'"uuid":"code-1"'&text:'"editing":false'
