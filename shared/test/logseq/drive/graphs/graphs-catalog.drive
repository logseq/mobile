# Refresh splits remote and shared graphs out of the local list.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "CatalogGraph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
press prop:accessibility-identifier=link.sidebar.graphs
wait prop:accessibility-identifier=screen.graphs
expect prop:accessibility-identifier=graph.CatalogGraph
expect-absent prop:accessibility-identifier=heading.graphs.remote
press prop:accessibility-identifier=button.graphs.refresh
wait prop:accessibility-identifier=heading.graphs.remote
expect prop:accessibility-identifier=graph.RemoteGraph
expect prop:accessibility-identifier=heading.graphs.shared
expect prop:accessibility-identifier=graph.SharedGraph
expect prop:accessibility-identifier=graph.CatalogGraph
