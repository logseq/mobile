# The first encrypted graph asks for an E2EE password, then opens the unlock sheet.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
wait prop:accessibility-identifier=sheet.graph-create
type prop:accessibility-identifier=field.graph-name "Password Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=field.graph-create.password
type prop:accessibility-identifier=field.graph-create.password "secret-pass"
type prop:accessibility-identifier=field.graph-create.password-confirmation "secret-pass"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=sheet.graph-unlock
expect-absent prop:accessibility-identifier=sheet.graph-create
