# Moving Flashcards below Graphs stays after a graph refresh.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
press kind:menu-item&text:"Settings"
wait prop:accessibility-identifier=sheet.settings
press prop:accessibility-identifier=link.settings.general
press prop:accessibility-identifier=link.settings.tabs
wait prop:accessibility-identifier=sheet.settings.tabs
press prop:accessibility-identifier=button.settings.tab.flashcards.down
expect text:"Journals · Graphs · Flashcards"
press prop:accessibility-identifier=button.connection.cancel
press prop:accessibility-identifier=button.connection.apply
expect-absent prop:accessibility-identifier=sheet.settings
press prop:accessibility-identifier=link.sidebar.graphs
wait prop:accessibility-identifier=screen.graphs
press prop:accessibility-identifier=button.graphs.refresh
press prop:accessibility-identifier=button.sidebar.settings
wait prop:accessibility-identifier=sheet.settings
press prop:accessibility-identifier=link.settings.general
expect text:"Journals · Graphs · Flashcards"
