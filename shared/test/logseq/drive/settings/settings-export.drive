# Export stays in Advanced settings and records the native export.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
press prop:accessibility-identifier=button.sidebar.settings
wait prop:accessibility-identifier=sheet.settings
press prop:accessibility-identifier=link.settings.advanced
expect prop:accessibility-identifier=button.export-graph-database
press prop:accessibility-identifier=button.export-graph-database
expect prop:accessibility-identifier=sheet.settings
expect prop:accessibility-identifier=button.export-graph-database
press prop:accessibility-identifier=button.connection.cancel
expect prop:accessibility-identifier=link.settings.about
press prop:accessibility-identifier=link.settings.about
press prop:accessibility-identifier=button.runtime-log
wait prop:accessibility-identifier=screen.runtime-log
wait text:"Exported graph database"
