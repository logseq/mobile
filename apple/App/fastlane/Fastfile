# This file contains the fastlane.tools configuration
# for the Apple app.
# You can find the documentation at https://docs.fastlane.tools

require "shellwords"
require "digest"

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
    )

    sync_code_signing(
      type: "appstore",
      readonly: is_ci
    )

    repo_root = File.expand_path("../../..", __dir__)
    version_number = File.read(File.join(repo_root, "version.xcconfig"))
      .match(/^MARKETING_VERSION\s*=\s*(.+)$/)[1].strip
    revision = sh("git -C #{Shellwords.escape(repo_root)} rev-parse --short=8 HEAD", log: false).strip

    latest_build_number = latest_testflight_build_number(
      version: version_number,
      initial_build_number: 1,
    )
    build_number = latest_build_number + 1

    # The OCaml core objects are linked through the SwiftPM manifest's
    # LOGSEQ_NATIVE_LINK_INPUTS env lookup; the workflow builds them first.
    link_inputs_file = File.expand_path("../../../../_build/ios-core/device/native-link-inputs.txt", __FILE__)
    ENV["LOGSEQ_NATIVE_LINK_INPUTS"] = File.read(link_inputs_file).strip
    # Xcode caches SwiftPM's evaluated manifest, including environment-derived
    # linker inputs. Keep that cache scoped to the native objects it links.
    native_cache_key = Digest::SHA256.hexdigest(ENV.fetch("LOGSEQ_NATIVE_LINK_INPUTS"))

    # CURRENT_PROJECT_VERSION is overridden on the command line so every
    # upload lands a unique build number without editing the xcconfig.
    release_dir = File.join(repo_root, "_build/ios-release")
    archive_path = File.join(release_dir, "Logseq.xcarchive")
    build_options = {
      project: "Logseq.xcodeproj",
      destination: "generic/platform=iOS",
      scheme: "Logseq App",
      configuration: "Release",
      archive_path: archive_path,
      derived_data_path: File.join(repo_root, "apple/.build/archives", native_cache_key),
      xcargs: "-allowProvisioningUpdates -skipPackagePluginValidation -skipMacroValidation CURRENT_PROJECT_VERSION=#{build_number} LOGSEQ_BUILD_REVISION=#{revision}"
    }
    build_app(**build_options, skip_package_ipa: true)

    verifier = File.join(repo_root, "scripts/verify-ios-release-bundle.py")
    verification_args = ["--version", version_number, "--build", build_number.to_s,
                         "--revision", revision, "--app-store"]
    sh("python3", verifier, File.join(archive_path, "Products/Applications/Logseq.app"),
       *verification_args, "--report", File.join(release_dir, "archive-verification.json"))

    ipa = build_app(**build_options, skip_build_archive: true,
                    output_directory: release_dir, output_name: "Logseq.ipa")
    sh("python3", verifier, ipa, *verification_args,
       "--report", File.join(release_dir, "ipa-verification.json"))

    upload_to_testflight(
      ipa: ipa,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )

  end
end
