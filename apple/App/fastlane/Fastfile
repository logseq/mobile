# This file contains the fastlane.tools configuration
# for the Apple app.
# You can find the documentation at https://docs.fastlane.tools

require "shellwords"
require "digest"

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
    )

    sync_code_signing(
      type: "appstore",
      readonly: is_ci
    )

    repo_root = File.expand_path("../../..", __dir__)
    version_number = File.read(File.join(repo_root, "version.xcconfig"))
      .match(/^MARKETING_VERSION\s*=\s*(.+)$/)[1].strip
    revision = sh("git -C #{Shellwords.escape(repo_root)} rev-parse --short=8 HEAD", log: false).strip

    latest_build_number = latest_testflight_build_number(
      version: version_number,
      initial_build_number: 1,
    )
    build_number = latest_build_number + 1

    # The OCaml core objects are linked through the SwiftPM manifest's
    # LOGSEQ_NATIVE_LINK_INPUTS env lookup; the workflow builds them first.
    link_inputs_file = File.expand_path("../../../../_build/ios-core/device/native-link-inputs.txt", __FILE__)
    ENV["LOGSEQ_NATIVE_LINK_INPUTS"] = File.read(link_inputs_file).strip
    # Xcode caches SwiftPM's evaluated manifest, including environment-derived
    # linker inputs. Keep that cache scoped to the native objects it links.
    native_cache_key = Digest::SHA256.hexdigest(ENV.fetch("LOGSEQ_NATIVE_LINK_INPUTS"))

    # CURRENT_PROJECT_VERSION is overridden on the command line so every
    # upload lands a unique build number without editing the xcconfig.
    build_app(
      project: "Logseq.xcodeproj",
      destination: "generic/platform=iOS",
      scheme: "Logseq App",
      configuration: "Release",
      derived_data_path: File.join(repo_root, "apple/.build/archives", native_cache_key),
      xcargs: "-allowProvisioningUpdates -skipPackagePluginValidation -skipMacroValidation CURRENT_PROJECT_VERSION=#{build_number} LOGSEQ_BUILD_REVISION=#{revision}"
    )

    sh("python3", File.join(repo_root, "scripts/verify-ios-native-symbols.py"),
       File.join(lane_context[SharedValues::XCODEBUILD_ARCHIVE], "Products/Applications/Logseq.app"))

    upload_to_testflight(
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )

  end
end
