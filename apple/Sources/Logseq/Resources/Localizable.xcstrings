    "Task reminder" : {"comment":"Generic lock-screen title for a Logseq task reminder","localizations":{"es":{"stringUnit":{"state":"translated","value":"Recordatorio de tarea"}},"fr":{"stringUnit":{"state":"translated","value":"Rappel de tâche"}},"ja":{"stringUnit":{"state":"translated","value":"タスクリマインダー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"任务提醒"}}}},
    "A task is due." : {"comment":"Privacy-safe lock-screen body for a Logseq task reminder","localizations":{"es":{"stringUnit":{"state":"translated","value":"Hay una tarea pendiente."}},"fr":{"stringUnit":{"state":"translated","value":"Une tâche est à faire."}},"ja":{"stringUnit":{"state":"translated","value":"期限のタスクがあります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"有一项任务到期。"}}}},
    "Notification permission is unavailable." : {"comment":"Task reminder settings status","localizations":{"es":{"stringUnit":{"state":"translated","value":"Los permisos de notificación no están disponibles."}},"fr":{"stringUnit":{"state":"translated","value":"L’autorisation de notification n’est pas disponible."}},"ja":{"stringUnit":{"state":"translated","value":"通知の許可を利用できません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知权限不可用。"}}}},
    "Allow notifications in iOS Settings to enable task reminders." : {"comment":"Task reminder settings status after permission denial or revocation","localizations":{"es":{"stringUnit":{"state":"translated","value":"Permite las notificaciones en Ajustes de iOS para activar los recordatorios de tareas."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez les notifications dans Réglages iOS pour activer les rappels de tâches."}},"ja":{"stringUnit":{"state":"translated","value":"タスクリマインダーを有効にするには、iOSの設定で通知を許可してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请在 iOS 设置中允许通知，以启用任务提醒。"}}}},
