opam-version: "2.0"
synopsis: "Logseq mobile core backed by DataScript OCaml"
maintainer: "Logseq <hello@logseq.com>"
authors: "Logseq"
license: "MIT"
depends: [
  "ocaml" {>= "5.1.0"}
  "dune" {>= "3.17"}
  "datascript_ocaml"
  "datascript-ocaml-native"
  "melange-edn-native"
  "melange-transit-native"
  "lui"
  "ocaml-signal"
  "ctypes"
  "ctypes-foreign"
  "alcotest" {with-test}
  "drive" {with-test}
  "mldoc"
  "ocaml-fsrs"
  "yojson"
  "sqlite3"
  "re"
  "uucp"
  "uunf"
]
pin-depends: [
  ["datascript_ocaml.dev" "git+https://github.com/logseq/datascript-ocaml.git#505c85564d62dc2864c43a0634ad65ee6f58550c"]
  ["datascript-ocaml-native.dev" "git+https://github.com/logseq/datascript-ocaml.git#505c85564d62dc2864c43a0634ad65ee6f58550c"]
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#695223e0a28cec1ff13a6ac7e870e4983ad3bb46"]
  ["melange-edn-core.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-edn-native.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-edn-melange.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-transit-core.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["melange-transit-native.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["melange-transit-melange.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["lui.0.1.0" "git+ssh://git@github.com/logseq/lui.git#5bfad989d75500e6932b824c67847528c0cc8301"]
  ["drive.dev" "git+https://github.com/logseq/drive.git#dd735a65ed525d1c36db38ac8e8114aa81d314a1"]
  ["ocaml-signal.0.1.0" "git+https://github.com/logseq/ocaml-signal.git#02e18cdc5e0ad672aa223f638eaa3ba52fc9421e"]
  ["mldoc.dev" "git+https://github.com/logseq/mldoc.git#f11230c367964af2b575524d00779cfb1ffc7147"]
  ["angstrom.dev" "git+https://github.com/logseq/angstrom.git#3be9b966dc2bc9ccf9948d17a7b0df1cb526de15"]
  ["xmlm.dev" "git+https://github.com/logseq/xmlm.git#eb469d536e98c98f2754c0ff8813c92b3a17fe9f"]
  ["ocaml-fsrs.0.1.0-alpha3" "git+https://github.com/logseq/ocaml-fsrs.git#472b8ff1b86e5afd2ac4bbeba5e2eecedd3948fc"]
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test}]
]
