<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SystemBarThemeBase" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:statusBarColor">#FCFCFC</item>
        <item name="android:navigationBarColor">#FCFCFC</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SystemBarNavigationTheme" parent="SystemBarThemeBase" />
    <style name="SystemBarContrastTheme" parent="SystemBarNavigationTheme" />
    <style name="SystemBarCutoutTheme" parent="SystemBarContrastTheme" />
    <style name="SystemBarTheme" parent="SystemBarCutoutTheme" />

    <style name="LaunchTheme" parent="SystemBarTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="SystemBarTheme">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
